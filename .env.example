# Public base URL is derived from the incoming request (X-Forwarded-* headers).
# Run uvicorn with --proxy-headers --forwarded-allow-ips='*' behind a tunnel/proxy.

# Comma separated list of Saleor domains allowed to install this app. Empty = allow any (dev only).
ALLOWED_SALEOR_DOMAINS=

# Set to true when Saleor runs on plain http (local docker-compose).
USE_INSECURE_SALEOR_HTTP=false

# Where installation data and per-shop settings are stored.
DATABASE_PATH=./data/app.sqlite3

# Optional: bypass X-Saleor-Token for local API testing (never in production).
DEVELOPMENT_AUTH_TOKEN=

DEBUG=false
