# Required: encrypts stored AI provider keys and signs media URLs. Generate: openssl rand -hex 32
SECRET_KEY=

# Comma separated list of Saleor domains allowed to install. Empty = any (dev only).
ALLOWED_SALEOR_DOMAINS=
USE_INSECURE_SALEOR_HTTP=false
DATABASE_PATH=/data/app.sqlite3
DATA_DIR=/data
DEVELOPMENT_AUTH_TOKEN=
DEBUG=false
